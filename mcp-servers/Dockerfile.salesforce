FROM python:3.13-slim-trixie AS builder

WORKDIR /app

# Install git to clone the repository
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Clone the salesforce-mcp repository
ARG SALESFORCE_MCP_REPO=https://github.com/obot-platform/salesforce-mcp.git
ARG SALESFORCE_MCP_COMMIT=main
RUN git clone ${SALESFORCE_MCP_REPO} . && \
    git checkout ${SALESFORCE_MCP_COMMIT}

# Install dependencies
RUN uv sync --frozen --no-dev

FROM python:3.13-slim-trixie AS runner

WORKDIR /app

# Copy the virtual environment and application code from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/app /app/app
COPY --from=builder /app/pyproject.toml /app/pyproject.toml

ENV PATH="/app/.venv/bin:$PATH"

# Expose port
EXPOSE 9000

# Run the application
CMD ["/app/.venv/bin/python", "-m", "app.main"]
